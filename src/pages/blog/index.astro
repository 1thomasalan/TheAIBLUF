---
import Layout from '../../layouts/Layout.astro';
import BlogPostCard from '@/components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const contentPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Fallback to hardcoded posts if content collection is empty
const hardcodedPosts = [
  { 
    title: "The Future of AI", 
    date: new Date("2023-10-11"), 
    tags: ["AI", "Technology"], 
    slug: "future-of-ai",
    excerpt: "Explore the cutting-edge developments shaping the future of artificial intelligence and its potential impact on various industries."
  },
  { 
    title: "Machine Learning Basics", 
    date: new Date("2023-10-10"), 
    tags: ["Machine Learning", "Beginner"], 
    slug: "machine-learning-basics",
    excerpt: "Dive into the fundamental concepts of machine learning, including key algorithms and their applications in real-world scenarios."
  },
];

const sortedPosts = contentPosts.length > 0 ? contentPosts : hardcodedPosts;
---

<Layout title="Blog - The AI BLUF">
  <h1 class="text-3xl font-bold mb-8">All Posts</h1>
  <div class="space-y-6">
    {sortedPosts.map((post) => (
      <BlogPostCard
        title={post.data ? post.data.title : post.title}
        date={post.data ? post.data.date : post.date}
        tags={post.data ? post.data.tags : post.tags}
        slug={post.slug}
        excerpt={post.data ? post.data.excerpt : post.excerpt}
      />
    ))}
  </div>
</Layout>