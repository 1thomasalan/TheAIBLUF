---
import { Card } from "@/components/ui/card"

interface Props {
  title: string;
  date: string | Date;
  tags: string[];
  slug: string;
  excerpt: string;
}

const { title, date, tags, slug, excerpt } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<Card class="overflow-hidden">
  <div class="flex h-full">
    <div class="flex-shrink-0 w-20 bg-secondary text-secondary-foreground flex flex-col items-center justify-center p-4">
      <span class="text-3xl font-bold">{new Date(date).getDate()}</span>
      <span class="text-sm uppercase">{new Date(date).toLocaleString('default', { month: 'short' })}</span>
    </div>
    <div class="flex-grow p-6 flex flex-col">
      <h2 class="text-2xl font-semibold mb-2">{title}</h2>
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="bg-muted text-muted-foreground px-2 py-1 rounded-full text-xs">{tag}</span>
        ))}
      </div>
      <p class="text-foreground mb-4">{excerpt}</p>
      <div class="mt-auto">
        <a href={`/blog/${slug}`} class="text-primary hover:underline">Read More</a>
      </div>
    </div>
  </div>
</Card>