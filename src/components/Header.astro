---
import { Button } from "@/components/ui/button"
import { Menu } from "lucide-react"
import MobileMenu from "./MobileMenu.astro"
import ThemeToggle from "./ThemeToggle"
---

<header class="fixed top-0 left-0 right-0 bg-background border-b z-50">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <a href="/" class="text-2xl font-bold">
      The AI BLUF
    </a>
    <div class="flex items-center space-x-4">
      <nav class="hidden md:flex space-x-4">
        <a href="/" class="text-sm font-medium hover:text-primary transition-colors duration-200">Home</a>
        <a href="/about" class="text-sm font-medium hover:text-primary transition-colors duration-200">About</a>
        <a href="/blog" class="text-sm font-medium hover:text-primary transition-colors duration-200">Blog</a>
      </nav>
      <ThemeToggle client:load />
      <Button id="mobile-menu-toggle" variant="ghost" size="icon" class="md:hidden" aria-label="Toggle menu">
        <Menu className="h-6 w-6" />
        <span class="sr-only">Toggle menu</span>
      </Button>
    </div>
  </div>
</header>

<MobileMenu />